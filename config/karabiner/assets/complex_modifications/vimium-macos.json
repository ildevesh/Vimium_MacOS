{
  "title": "Vimium macOS",
  "rules": [
    {
      "description": "Vimium macOS - core keyboard layer",
      "manipulators": [
        {
          "type": "basic",
          "description": "Super+V (Hyper+V) toggles Vim mode",
          "from": {
            "key_code": "v",
            "modifiers": {
              "mandatory": ["left_command", "left_control", "left_option", "left_shift"]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "vim_mode",
                "expression": "vim_mode != 0 ? 0 : 1"
              }
            }
          ]
        },
        {
          "type": "basic",
          "description": "s = scroll down",
          "from": {"key_code": "s", "modifiers": {"optional": ["any"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'"}
          ],
          "to": [{"mouse_key": {"vertical_wheel": 64}}]
        },
        {
          "type": "basic",
          "description": "w = scroll up",
          "from": {"key_code": "w", "modifiers": {"optional": ["any"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'"}
          ],
          "to": [{"mouse_key": {"vertical_wheel": -64}}]
        },
        {
          "type": "basic",
          "description": "a = scroll left",
          "from": {"key_code": "a", "modifiers": {"optional": ["any"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'"}
          ],
          "to": [{"mouse_key": {"horizontal_wheel": 64}}]
        },
        {
          "type": "basic",
          "description": "d = scroll right",
          "from": {"key_code": "d", "modifiers": {"optional": ["any"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'"}
          ],
          "to": [{"mouse_key": {"horizontal_wheel": -64}}]
        },
        {
          "type": "basic",
          "description": "S = full-page scroll down",
          "from": {"key_code": "s", "modifiers": {"mandatory": ["left_shift"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'"}
          ],
          "to": [{"key_code": "page_down"}]
        },
        {
          "type": "basic",
          "description": "W = full-page scroll up",
          "from": {"key_code": "w", "modifiers": {"mandatory": ["left_shift"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'"}
          ],
          "to": [{"key_code": "page_up"}]
        },
        {
          "type": "basic",
          "description": "h = back",
          "from": {"key_code": "h", "modifiers": {"optional": ["any"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'"}
          ],
          "to": [{"key_code": "open_bracket", "modifiers": ["left_command"]}]
        },
        {
          "type": "basic",
          "description": "l = forward",
          "from": {"key_code": "l", "modifiers": {"optional": ["any"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'"}
          ],
          "to": [{"key_code": "close_bracket", "modifiers": ["left_command"]}]
        },
        {
          "type": "basic",
          "description": "Command+Shift+A = back",
          "from": {"key_code": "a", "modifiers": {"mandatory": ["left_command", "left_shift"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'"}
          ],
          "to": [{"key_code": "open_bracket", "modifiers": ["left_command"]}]
        },
        {
          "type": "basic",
          "description": "Command+Shift+D = forward",
          "from": {"key_code": "d", "modifiers": {"mandatory": ["left_command", "left_shift"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'"}
          ],
          "to": [{"key_code": "close_bracket", "modifiers": ["left_command"]}]
        },

        {
          "type": "basic",
          "description": "Super+Q = next tab - Safari",
          "from": {"key_code": "q", "modifiers": {"mandatory": ["left_command", "left_control", "left_option", "left_shift"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.Safari$"]}
          ],
          "to": [{"key_code": "tab", "modifiers": ["left_control"]}]
        },
        {
          "type": "basic",
          "description": "Super+Q = next tab - Chrome/Chromium",
          "from": {"key_code": "q", "modifiers": {"mandatory": ["left_command", "left_control", "left_option", "left_shift"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "frontmost_application_if", "bundle_identifiers": ["^com\\.google\\.Chrome$", "^org\\.chromium\\.Chromium$"]}
          ],
          "to": [{"key_code": "right_arrow", "modifiers": ["left_command", "left_option"]}]
        },
        {
          "type": "basic",
          "description": "Super+Q = next tab - Dia",
          "from": {"key_code": "q", "modifiers": {"mandatory": ["left_command", "left_control", "left_option", "left_shift"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "frontmost_application_if", "bundle_identifiers": ["^company\\.thebrowser\\.dia$"]}
          ],
          "to": [{"key_code": "close_bracket", "modifiers": ["left_command", "left_shift"]}]
        },

        {
          "type": "basic",
          "description": "Super+E = previous tab - Safari",
          "from": {"key_code": "e", "modifiers": {"mandatory": ["left_command", "left_control", "left_option", "left_shift"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.Safari$"]}
          ],
          "to": [{"key_code": "tab", "modifiers": ["left_control", "left_shift"]}]
        },
        {
          "type": "basic",
          "description": "Super+E = previous tab - Chrome/Chromium",
          "from": {"key_code": "e", "modifiers": {"mandatory": ["left_command", "left_control", "left_option", "left_shift"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "frontmost_application_if", "bundle_identifiers": ["^com\\.google\\.Chrome$", "^org\\.chromium\\.Chromium$"]}
          ],
          "to": [{"key_code": "left_arrow", "modifiers": ["left_command", "left_option"]}]
        },
        {
          "type": "basic",
          "description": "Super+E = previous tab - Dia",
          "from": {"key_code": "e", "modifiers": {"mandatory": ["left_command", "left_control", "left_option", "left_shift"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "frontmost_application_if", "bundle_identifiers": ["^company\\.thebrowser\\.dia$"]}
          ],
          "to": [{"key_code": "open_bracket", "modifiers": ["left_command", "left_shift"]}]
        },

        {
          "type": "basic",
          "description": "Tab+Q = move current tab to a new window",
          "from": {
            "simultaneous": [{"key_code": "tab"}, {"key_code": "q"}],
            "simultaneous_options": {
              "detect_key_down_uninterruptedly": true,
              "key_down_order": "insensitive",
              "key_up_order": "insensitive"
            }
          },
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'"}
          ],
          "to": [{"key_code": "f18"}]
        },

        {
          "type": "basic",
          "description": "o = address/search bar",
          "from": {"key_code": "o", "modifiers": {"optional": ["any"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'"},
            {"type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.Safari$", "^com\\.google\\.Chrome$", "^org\\.chromium\\.Chromium$", "^company\\.thebrowser\\.dia$"]}
          ],
          "to": [{"key_code": "l", "modifiers": ["left_command"]}]
        },
        {
          "type": "basic",
          "description": "O = new tab",
          "from": {"key_code": "o", "modifiers": {"mandatory": ["left_shift"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'"},
            {"type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.Safari$", "^com\\.google\\.Chrome$", "^org\\.chromium\\.Chromium$", "^company\\.thebrowser\\.dia$"]}
          ],
          "to": [{"key_code": "t", "modifiers": ["left_command"]}]
        },
        {
          "type": "basic",
          "description": "~ = edit URL",
          "from": {"key_code": "grave_accent_and_tilde", "modifiers": {"optional": ["any"]}},
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1},
            {"type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'"},
            {"type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.Safari$", "^com\\.google\\.Chrome$", "^org\\.chromium\\.Chromium$", "^company\\.thebrowser\\.dia$"]}
          ],
          "to": [{"key_code": "l", "modifiers": ["left_command"]}]
        },

        {
          "type": "basic",
          "description": "Super+Space = command palette",
          "from": {
            "key_code": "spacebar",
            "modifiers": {
              "mandatory": ["left_command", "left_control", "left_option", "left_shift"]
            }
          },
          "conditions": [
            {"type": "variable_if", "name": "vim_mode", "value": 1}
          ],
          "to": [{"key_code": "f16"}]
        }
      ]
    }
  ]
}
